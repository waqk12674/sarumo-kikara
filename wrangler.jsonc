{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarumo-kikara",
  "compatibility_date": "2026-10-01",
  // waqk.jp/sarumo-kikara/* をこの Worker のルートにする（ハブを通さない。手本は dashimaki）。
  // 届いたパスの先頭の /sarumo-kikara は _redirects（/sarumo-kikara/* /:splat 200）で外して静的ファイルを返す
  "routes": [{ "pattern": "waqk.jp/sarumo-kikara/*", "zone_name": "waqk.jp" }],
  // routes を書くと workers.dev が既定で無効になるため、有効にしておく（workers.dev には _headers で noindex）
  "workers_dev": true,
  // ランキングの API（/api/scores）と英語版（/en/）だけを Worker が処理する。それ以外の静的ファイルは Worker を通らない
  // （Workers のリクエストに数えない）。公開するファイルは .assetsignore の許可リストで決める
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /sarumo-kikara/… は waqk.jp のルートから届くとき、先頭なしは workers.dev・wrangler dev のとき
    "run_worker_first": ["/sarumo-kikara/api/*", "/sarumo-kikara/en", "/sarumo-kikara/en/", "/api/*", "/en", "/en/"]
  },
  // ランキング（表は schema.sql）
  "d1_databases": [
    { "binding": "DB", "database_name": "sarumo-kikara-scores", "database_id": "6c5d4df5-2176-43a2-a84e-604aa6521841" }
  ]
}
